{
  "name": "cwe-navigation",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run data:generate && vite build",
    "preview": "vite preview",
    "lint": "eslint . --fix",
    "format": "prettier --write src/",
    "data:generate": "tsx data_scripts/nodejs/src/generate.ts",
    "data:test": "npm run test --workspace data_scripts/nodejs",
    "data:typecheck": "npm run typecheck --workspace data_scripts/nodejs"
  },
  "workspaces": [
    "data_scripts/nodejs"
  ],
  "dependencies": {
    "echarts": "^6.1.0",
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/eslint-config-prettier": "^10.2.0",
    "eslint": "^10.9.1",
    "eslint-plugin-vue": "^10.10.0",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.2"
  }
}
